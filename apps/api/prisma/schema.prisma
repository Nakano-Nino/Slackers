// Prisma Schema for Slackers (PostgreSQL)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum UserStatus {
  ONLINE
  OFFLINE
  AWAY
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BugSeverity {
  CRITICAL
  MAJOR
  MINOR
  COSMETIC
}

enum BugStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum BugEnvironment {
  PRODUCTION
  STAGING
  DEVELOPMENT
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String
  name          String
  avatar        String
  publicKey           String?         @db.Text
  encryptedPrivateKey String?         @db.Text
  keyVaultSalt        String?         @db.Text
  keyVaultIv          String?         @db.Text
  role                UserRole        @default(MEMBER)
  developerRole       String?
  status              UserStatus      @default(ONLINE)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  messages      Message[]
  sentDMs       DirectMessage[] @relation("SentDMs")
  receivedDMs   DirectMessage[] @relation("ReceivedDMs")
  assignedTasks Task[]          @relation("AssignedTasks")
  createdTasks  Task[]          @relation("CreatedTasks")
  taskComments  TaskComment[]
  reportedBugs  Bug[]           @relation("ReportedBugs")
  assignedBugs  Bug[]           @relation("AssignedBugs")
  ownedProjects Project[]       @relation("ProjectOwner")
  projectMembers ProjectMember[]
  memberships   ChannelMember[]
  channelKeys   ChannelKey[]

  @@map("users")
}

model Project {
  id          String          @id @default(cuid())
  name        String
  key         String          @unique
  description String?         @db.Text
  isPrivate   Boolean         @default(false)
  memberIds   String[]        @default([])
  ownerId     String
  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  members     ProjectMember[]
  tasks       Task[]
  bugs        Bug[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Channel {
  id          String          @id
  name        String          @unique
  description String?
  isPrivate   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  messages    Message[]
  members     ChannelMember[]
  keys        ChannelKey[]
  webhooks    Webhook[]

  @@map("channels")
}

model ChannelMember {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@map("channel_members")
}

model ChannelKey {
  id           String   @id @default(cuid())
  channelId    String
  userId       String
  encryptedKey String   @db.Text
  iv           String   @db.Text
  createdAt    DateTime @default(now())

  channel      Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@map("channel_keys")
}

model Message {
  id         String   @id @default(cuid())
  channelId  String
  userId     String
  ciphertext String   @db.Text
  iv         String   @db.Text
  content    String?  @db.Text
  taskId     String?
  bugId      String?
  parentId   String?
  replyCount Int      @default(0)
  lastReplyAt DateTime?
  isEdited   Boolean  @default(false)
  isDeleted  Boolean  @default(false)
  editedAt   DateTime?
  reactions  Json?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([channelId, createdAt])
  @@index([parentId])
  @@index([expiresAt])
  @@map("messages")
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(BACKLOG)
  priority    TaskPriority @default(MEDIUM)
  storyPoints Int          @default(1)
  tags        String[]
  dueDate     DateTime?

  assigneeId  String?
  assignee    User?        @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  creatorId   String?
  creator     User?        @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: SetNull)

  qaSteps     Json?
  qaVerdict   String?
  subtasks    Json?
  attachments Json?

  comments    TaskComment[]
  bugs        Bug[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId])
  @@index([status])
  @@index([projectId, status])
  @@index([assigneeId])
  @@map("tasks")
}

model Bug {
  id                 String         @id @default(cuid())
  projectId          String
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title              String
  description        String         @db.Text
  severity           BugSeverity    @default(MAJOR)
  status             BugStatus      @default(OPEN)
  environment        BugEnvironment @default(PRODUCTION)
  reproductionSteps  String?        @db.Text
  expectedBehavior   String?        @db.Text
  actualBehavior     String?        @db.Text

  reportedById       String
  reportedBy         User           @relation("ReportedBugs", fields: [reportedById], references: [id], onDelete: Cascade)

  assignedToId       String?
  assignedTo         User?          @relation("AssignedBugs", fields: [assignedToId], references: [id], onDelete: SetNull)

  taskId             String?
  task               Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([projectId])
  @@index([severity])
  @@index([status])
  @@map("bugs")
}

model DirectMessage {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  ciphertext String    @db.Text
  iv         String
  senderCopy String?   @db.Text
  isRead     Boolean   @default(false)
  readAt     DateTime?
  isEdited   Boolean   @default(false)
  isDeleted  Boolean   @default(false)
  editedAt   DateTime?
  reactions  Json?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  sender     User      @relation("SentDMs", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User      @relation("ReceivedDMs", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId, createdAt])
  @@index([expiresAt])
  @@map("direct_messages")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([taskId, createdAt])
  @@map("task_comments")
}

model Invitation {
  id            String    @id @default(cuid())
  email         String
  role          String
  developerRole String?
  token         String    @unique
  inviterId     String
  status        String    @default("pending")
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  acceptedAt    DateTime?

  @@map("invitations")
}

model Notification {
  id           String   @id @default(cuid())
  recipientId  String
  senderId     String
  senderName   String
  senderAvatar String?
  type         String
  title        String
  content      String   @db.Text
  link         Json?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([recipientId])
  @@map("notifications")
}

enum WebhookType {
  GENERIC
  GITHUB
  GITLAB
}

model Webhook {
  id          String       @id @default(cuid())
  name        String
  channelId   String
  token       String       @unique
  secret      String?
  type        WebhookType  @default(GENERIC)
  avatar      String?
  creatorId   String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  channel     Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  logs        WebhookLog[]

  @@index([token])
  @@index([channelId])
  @@map("webhooks")
}

model WebhookLog {
  id          String   @id @default(cuid())
  webhookId   String
  event       String
  status      Int
  payload     Json?
  error       String?  @db.Text
  durationMs  Int      @default(0)
  createdAt   DateTime @default(now())

  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([createdAt])
  @@map("webhook_logs")
}

model AutomationRule {
  id          String   @id @default(cuid())
  name        String
  trigger     String
  conditions  Json?
  actions     Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([trigger])
  @@map("automation_rules")
}

