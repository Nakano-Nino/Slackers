# ==============================================================================
# Slackers Production Environment Configuration
# Copy this file to .env.production on your Ubuntu VPS and fill in the values.
# ==============================================================================

# Application URL / Domain (Used for CORS and redirects)
# Set to your VPS public IP (e.g. http://123.45.67.89) or custom domain (e.g. https://chat.yourdomain.com)
APP_URL=http://

# Optional: Seed initial demo accounts (admin, alex, sarah, marcus) on initial container boot
# Set to 'true' for first-time startup, then set back to 'false'
SEED_DB=true

# JWT Authentication Secret (Generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_key

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Supabase Cloud Database)
# ------------------------------------------------------------------------------
# DATABASE_URL: Transaction pooler connection (port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: Direct session connection (port 5432) for Prisma migrations
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------------------
# MongoDB Configuration (Docker container)
# ------------------------------------------------------------------------------
MONGO_INITDB_DATABASE=slackers_logs
MONGODB_URI=mongodb://mongodb:27017/slackers_logs

# ------------------------------------------------------------------------------
# Redis Configuration (Docker container)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# MinIO / S3 Object Storage Configuration (Docker container)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_a_secure_minio_password
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace_with_a_secure_minio_password
S3_BUCKET_NAME=slackers-encrypted-files
S3_FORCE_PATH_STYLE=true
