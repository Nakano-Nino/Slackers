# ==============================================================================
# Slackers Hybrid Environment Configuration (Ubuntu VPS)
# Databases (Postgres, Mongo, Redis) in Docker | Apps & Nginx in PM2
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API Configuration (apps/api/.env)
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=production

# Public URL of your site (set to your domain or VPS IP)
# Examples:
#   CLIENT_URL=http://123.45.67.89
#   CLIENT_URL=https://chat.yourdomain.com
CLIENT_URL=http://localhost

# JWT Authentication Secret (Generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_key

# Database Connections (Connects to Docker containers on 127.0.0.1)
DATABASE_URL="postgresql://slackers:slackers_secret@127.0.0.1:5432/slackers_db?schema=public"
MONGODB_URI="mongodb://127.0.0.1:27017/slackers_logs"
REDIS_URL="redis://127.0.0.1:6379"

# Object Storage (Leave commented out to use fast local disk storage in apps/api/uploads/)
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET_NAME=slackers-encrypted-files

# Database Seeding: false keeps database clean and empty; true seeds demo accounts
SEED_DB=false

# ------------------------------------------------------------------------------
# 2. Frontend Web Configuration (apps/web/.env.local)
# ------------------------------------------------------------------------------
# Leave empty ("") so the browser uses relative URLs (/api/...) proxied via Nginx
NEXT_PUBLIC_API_URL=""
NODE_ENV=production
PORT=3000
