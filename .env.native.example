# ==============================================================================
# Slackers Native Environment Configuration (Ubuntu VPS - No Docker)
# Copy this file to apps/api/.env and apps/web/.env.local on your VPS.
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=5001

# Public URL / Domain (Used by Express CORS and links)
# Set to your VPS public IP (e.g. http://123.45.67.89) or domain (e.g. https://chat.yourdomain.com)
CLIENT_URL=http://localhost

# JWT Authentication Secret (Generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_key

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Native Ubuntu service)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://axial:replace_with_a_secure_postgres_password@localhost:5432/slackers?schema=public"

# ------------------------------------------------------------------------------
# MongoDB Configuration (Native Ubuntu service)
# ------------------------------------------------------------------------------
MONGODB_URI="mongodb://localhost:27017/slackers_logs"

# ------------------------------------------------------------------------------
# Redis Configuration (Native Ubuntu service)
# ------------------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6379"

# ------------------------------------------------------------------------------
# Object Storage (Local Disk Mode)
# Leave S3_ENDPOINT commented out to automatically use fast native disk storage:
# uploads will be safely stored in apps/api/uploads/
# ------------------------------------------------------------------------------
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET_NAME=slackers-encrypted-files

# ------------------------------------------------------------------------------
# Database Seeding
# Set to false to keep database clean & empty. Set to true to generate demo accounts.
# ------------------------------------------------------------------------------
SEED_DB=false
