# ==============================================================================
# Slackers Environment Configuration (.env.example)
# Copy this file to .env and customize your environment credentials.
# ==============================================================================

# Application URL & Domain
APP_URL=http://localhost
DOMAIN_NAME=localhost
PORT=5001
NODE_ENV=production

# JWT Authentication Secret (Generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_key

# ------------------------------------------------------------------------------
# Supabase PostgreSQL (Cloud Database)
# ------------------------------------------------------------------------------
# DATABASE_URL: Transaction pooler connection (port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&search_path=public"
# DIRECT_URL: Direct session connection (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?search_path=public"

# ------------------------------------------------------------------------------
# Redis Pub/Sub & Presence
# ------------------------------------------------------------------------------
# Use "redis://redis:6379" for Docker or "redis://127.0.0.1:6379" for local
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# MongoDB Audit & Security Logs
# ------------------------------------------------------------------------------
# Use "mongodb://mongodb:27017/slackers_logs" for Docker or "mongodb://127.0.0.1:27017/slackers_logs" for local
MONGODB_URI=mongodb://mongodb:27017/slackers_logs
MONGO_INITDB_DATABASE=slackers_logs

# ------------------------------------------------------------------------------
# S3 / MinIO Object Storage (Encrypted File Attachments)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_a_secure_minio_password
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace_with_a_secure_minio_password
S3_BUCKET_NAME=slackers-encrypted-files
S3_FORCE_PATH_STYLE=true
